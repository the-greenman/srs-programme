  "description": "",
  "fields": [
    {
      "aiGuidance": {
        "purpose": "Plain markdown text of one comment, and the comment identity (its label is the start of this text). Humans and agents may write comments. Create the comment as a record, then relate it comments-on (comment to the record it addresses). A comment never edits its target. Authorship is the engine-stamped createdBy (RFC-046); never write an author here."
      },
      "createdAt": "2026-10-08T15:16:01.308941412+00:00",
      "description": "The text of a comment on a record.",
      "editorHint": "textarea",
      "fieldType": {
